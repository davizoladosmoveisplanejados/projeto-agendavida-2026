# AgendaVida - ambiente local
# Copie este arquivo para .env e substitua os valores de exemplo.
# NUNCA versione o arquivo .env com credenciais reais.

# Servidor Express
PORT=3000

# PostgreSQL / Sequelize
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agendavida
DB_USER=postgres
DB_PASSWORD=admin

# CORS: origens permitidas separadas por vírgula.
# Ajuste a porta conforme a configuração do frontend Vite.
CORS_ORIGIN=http://localhost:5173

# Limitação de requisições (15 minutos / até 100 requisições por IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
